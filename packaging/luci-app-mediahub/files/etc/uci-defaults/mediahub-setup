#!/bin/sh
# mediahub first-boot: data dir + AList deploy + service enable

chmod 755 /usr/bin/mediahub-cms.py /usr/bin/mediahub-alist-setup.sh \
	/usr/bin/mediahub-install.sh /usr/bin/alist-run \
	/etc/init.d/mediahub-cms /etc/init.d/alist 2>/dev/null || true

if [ -x /usr/bin/mediahub-alist-setup.sh ]; then
	if [ -x /usr/bin/alist ]; then
		# 升级：只同步 admin 密码，不重装二进制、不覆盖 init
		/usr/bin/mediahub-alist-setup.sh --sync-pw >/tmp/mediahub-alist-setup.log 2>&1 || true
	else
		/usr/bin/mediahub-alist-setup.sh >/tmp/mediahub-alist-setup.log 2>&1 || true
	fi
fi

[ -x /etc/init.d/alist ] && /etc/init.d/alist enable 2>/dev/null || true
[ -x /etc/init.d/mediahub-cms ] && /etc/init.d/mediahub-cms enable 2>/dev/null || true
[ -x /etc/init.d/alist ] && /etc/init.d/alist restart 2>/dev/null || true
[ -x /etc/init.d/mediahub-cms ] && /etc/init.d/mediahub-cms restart 2>/dev/null || true

rm -f /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache/

exit 0
