+static int extract_hostname_from_host_header(const char *host_header, char *out, size_t out_size) {
+  size_t n;
+  const char *colon;
+
+  if (!host_header || !host_header[0] || !out || out_size < 2)
+    return -1;
+
+  if (host_header[0] == '[') {
+    const char *end = strchr(host_header, ']');
+    if (!end)
+      return -1;
+    n = (size_t)(end - host_header + 1);
+  } else {
+    colon = strchr(host_header, ':');
+    if (colon && strchr(colon + 1, ':') == NULL)
+      n = (size_t)(colon - host_header);
+    else
+      n = strlen(host_header);
+  }
+  if (n == 0 || n >= out_size)
+    return -1;
+  memcpy(out, host_header, n);
+  out[n] = '\0';
+  return 0;
+}
+
+/* Replace tvg-logo="http(s)://OLD[:port]/logo/..." host with request hostname; keep port and path. */
+static char *m3u_rewrite_logo_hosts(char *playlist, const char *host_header) {
+  char new_host[256];
+  const char *src;
+  char *dst;
+  size_t cap;
+  size_t used = 0;
+  char *out;
+
+  if (!playlist || extract_hostname_from_host_header(host_header, new_host, sizeof(new_host)) != 0)
+    return NULL;
+
+  cap = strlen(playlist) + 1 + 256;
+  out = malloc(cap);
+  if (!out)
+    return NULL;
+  dst = out;
+  src = playlist;
+
+  while (*src) {
+    const char *attr = strstr(src, "tvg-logo=\"");
+    const char *url;
+    const char *host_start;
+    const char *host_end;
+    const char *p;
+    size_t prefix_len;
+    size_t host_len;
+    size_t need;
+
+    if (!attr) {
+      size_t rest = strlen(src);
+      need = used + rest + 1;
+      if (need > cap) {
+        char *grown = realloc(out, need);
+        if (!grown) {
+          free(out);
+          return NULL;
+        }
+        out = grown;
+        dst = out + used;
+        cap = need;
+      }
+      memcpy(dst, src, rest + 1);
+      return out;
+    }
+
+    prefix_len = (size_t)(attr - src) + 10; /* include tvg-logo=" */
+    url = attr + 10;
+    if (strncmp(url, "http://", 7) == 0)
+      p = url + 7;
+    else if (strncmp(url, "https://", 8) == 0)
+      p = url + 8;
+    else {
+      /* copy through this attr and continue */
+      size_t skip = prefix_len;
+      need = used + skip + 1;
+      if (need > cap) {
+        char *grown = realloc(out, cap * 2);
+        if (!grown) {
+          free(out);
+          return NULL;
+        }
+        out = grown;
+        dst = out + used;
+        cap *= 2;
+      }
+      memcpy(dst, src, skip);
+      dst += skip;
+      used += skip;
+      src += skip;
+      continue;
+    }
+
+    host_start = p;
+    if (*p == '[') {
+      const char *br = strchr(p, ']');
+      if (!br) {
+        size_t skip = prefix_len;
+        need = used + skip + 1;
+        if (need > cap) {
+          char *grown = realloc(out, cap * 2);
+          if (!grown) {
+            free(out);
+            return NULL;
+          }
+          out = grown;
+          dst = out + used;
+          cap *= 2;
+        }
+        memcpy(dst, src, skip);
+        dst += skip;
+        used += skip;
+        src += skip;
+        continue;
+      }
+      host_end = br + 1;
+      p = host_end;
+    } else {
+      while (*p && *p != ':' && *p != '/' && *p != '"')
+        p++;
+      host_end = p;
+    }
+    if (*p == ':') {
+      p++;
+      while (*p && *p != '/' && *p != '"')
+        p++;
+    }
+    if (strncmp(p, "/logo/", 6) != 0) {
+      size_t skip = prefix_len;
+      need = used + skip + 1;
+      if (need > cap) {
+        char *grown = realloc(out, cap * 2);
+        if (!grown) {
+          free(out);
+          return NULL;
+        }
+        out = grown;
+        dst = out + used;
+        cap *= 2;
+      }
+      memcpy(dst, src, skip);
+      dst += skip;
+      used += skip;
+      src += skip;
+      continue;
+    }
+
+    host_len = strlen(new_host);
+    need = used + prefix_len + (size_t)(host_start - url) + host_len + 1;
+    if (need > cap) {
+      size_t ncap = cap * 2;
+      char *grown;
+      while (ncap < need)
+        ncap *= 2;
+      grown = realloc(out, ncap);
+      if (!grown) {
+        free(out);
+        return NULL;
+      }
+      out = grown;
+      dst = out + used;
+      cap = ncap;
+    }
+    memcpy(dst, src, prefix_len);
+    dst += prefix_len;
+    used += prefix_len;
+    memcpy(dst, url, (size_t)(host_start - url));
+    dst += (size_t)(host_start - url);
+    used += (size_t)(host_start - url);
+    memcpy(dst, new_host, host_len);
+    dst += host_len;
+    used += host_len;
+    src = host_end;
+  }
+
+  *dst = '\0';
+  return out;
+}
