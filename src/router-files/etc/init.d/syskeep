#!/bin/sh /etc/rc.common

START=99
USE_PROCD=0

boot() {
	[ -f /etc/syskeep/pending ] || [ -f /etc/syskeep/restoring ] || return 0
	[ -x /etc/syskeep/restore.sh ] || return 0
	logger -t syskeep "boot: start restore"
	trap '' HUP
	nohup /etc/syskeep/restore.sh >>/tmp/syskeep-restore.out 2>&1 &
}

start() {
	boot
}
