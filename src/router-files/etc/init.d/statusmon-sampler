#!/bin/sh /etc/rc.common
# statusmon-sampler — 常驻轻量系统采样器（固定节奏写 /tmp/statusmon-snap）
# 由 procd 托管，异常退出自动拉起
START=98
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/statusmon-sampler
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/statusmon-snap /tmp/statusmon-snap.* 2>/dev/null
}

restart() {
	stop
	start
}
