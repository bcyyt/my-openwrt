#!/bin/sh /etc/rc.common
# Restore network/firewall UCI before netifd starts.

START=15
USE_PROCD=0

boot() {
	[ -f /etc/syskeep/pending ] || [ -f /etc/syskeep/restoring ] || return 0
	[ -f /etc/syskeep/datadir.sh ] || return 0
	. /etc/syskeep/datadir.sh
	syskeep_restore_uci /etc/syskeep/uci
}

start() {
	boot
}
