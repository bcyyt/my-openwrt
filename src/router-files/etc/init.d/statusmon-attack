#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get statusmon.attack.enabled)" = "0" ] && return 0
	mkdir -p /var/lib/statusmon-attack
	[ -x /usr/bin/statusmon-attack-nft.sh ] && /usr/bin/statusmon-attack-nft.sh >/dev/null 2>&1 || true
	procd_open_instance
	procd_set_param command /usr/bin/statusmon-attack.py
	procd_set_param respawn 5 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	[ -x /usr/bin/statusmon-attack-nft.sh ] && /usr/bin/statusmon-attack-nft.sh >/dev/null 2>&1 || true
}

service_triggers() {
	procd_add_reload_trigger "statusmon"
	procd_add_raw_trigger "interface.wan" 2000 /usr/bin/statusmon-attack-nft.sh
}
