#!/bin/sh /etc/rc.common
# mediahub-cms — CMS 聚合 + TVBox 配置 + 网盘 CMS 适配 服务

START=96
STOP=14
USE_PROCD=1

PROG=/usr/bin/mediahub-cms.py

start_service() {
    [ -f "$PROG" ] || return 0
    procd_open_instance
    procd_set_param command python3 "$PROG"
    procd_set_param respawn
    procd_set_param respawn_threshold 5
    procd_set_param respawn_timeout 10
    procd_set_param respawn_retry 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
