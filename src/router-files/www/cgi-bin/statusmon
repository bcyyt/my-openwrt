# v4.16：CPU/内存/温度 24h 滚动采样（cron 每分钟，独立 CPU 窗口）
_sm_sys_hist_cpu() {
    local tot idl pt pi pu dt di usage=0
    read -r _ u n s i w q sq st _ _ < /proc/stat 2>/dev/null
    [ -z "$i" ] && { echo 0; return; }
    tot=$((u + n + s + i + w + q + sq + st))
    idl=$((i + w))
    pt=0; pi=0; pu=0
    [ -f "$SYS_HIST_CPU" ] && read -r pt pi pu < "$SYS_HIST_CPU" 2>/dev/null
    case "$pt" in ''|*[!0-9]*) pt=0 ;; esac
    case "$pi" in ''|*[!0-9]*) pi=0 ;; esac
    case "$pu" in ''|*[!0-9]*) pu=0 ;; esac
    dt=$((tot - pt))
    di=$((idl - pi))
    if [ "$pt" -eq 0 ] || [ "$dt" -le 0 ]; then
        usage=$pu
    else
        usage=$(( (dt - di) * 100 / dt ))
        [ "$usage" -lt 0 ] && usage=0
        [ "$usage" -gt 100 ] && usage=100
    fi
    printf '%s %s %s\n' "$tot" "$idl" "$usage" > "$SYS_HIST_CPU.$$" 2>/dev/null && mv -f "$SYS_HIST_CPU.$$" "$SYS_HIST_CPU" 2>/dev/null
    echo "$usage"
}

_sm_sys_hist_temp() {
    local t z h
    for z in /sys/class/thermal/thermal_zone*; do
        [ -f "$z/type" ] && [ "$(cat "$z/type" 2>/dev/null)" = "x86_pkg_temp" ] && [ -f "$z/temp" ] && {
            t=$(cat "$z/temp" 2>/dev/null)
            [ -n "$t" ] && { awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return; }
        }
    done
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] && [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] && [ -f "$h/temp1_input" ] && {
            t=$(cat "$h/temp1_input" 2>/dev/null)
            [ -n "$t" ] && { awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return; }
        }
    done
    echo "0"
}

_sm_sys_hist_mem() {
    awk '
      /^MemTotal:/{t=$2}
      /^MemAvailable:/{a=$2}
      END{if(t>0) printf "%d", int((t-a)*100/t+0.5); else print 0}
    ' /proc/meminfo 2>/dev/null
}

sys_hist_sample() {
    local cpu mem temp cut lastf first=0
    mkdir -p "$PROTO_DIR" 2>/dev/null
    [ -s "$SYS_HIST_TMP" ] || { [ -s "$SYS_HIST_FILE" ] && cp -f "$SYS_HIST_FILE" "$SYS_HIST_TMP" 2>/dev/null; }
    [ -f "$SYS_HIST_CPU" ] || first=1
    cpu=$(_sm_sys_hist_cpu)
    mem=$(_sm_sys_hist_mem)
    temp=$(_sm_sys_hist_temp)
    cpu=${cpu:-0}; mem=${mem:-0}; temp=${temp:-0}
    [ "$first" = 1 ] && return 0
    cut=$((NOW - SYS_HIST_WIN))
    {
        [ -s "$SYS_HIST_TMP" ] && awk -v cut="$cut" '$1+0>=cut{print}' "$SYS_HIST_TMP"
        printf '%s %s %s %s\n' "$NOW" "$cpu" "$mem" "$temp"
    } > "$SYS_HIST_TMP.new" 2>/dev/null
    mv -f "$SYS_HIST_TMP.new" "$SYS_HIST_TMP" 2>/dev/null
    lastf=$(cat "$SYS_HIST_FLUSH" 2>/dev/null || echo 0)
    case "$lastf" in ''|*[!0-9]*) lastf=0 ;; esac
    if [ $((NOW - lastf)) -ge 300 ]; then
        cp -f "$SYS_HIST_TMP" "$SYS_HIST_FILE" 2>/dev/null
        echo "$NOW" > "$SYS_HIST_FLUSH"
    fi
}

sys_hist_json() {
    local f="$SYS_HIST_TMP"
    [ -s "$f" ] || f="$SYS_HIST_FILE"
    [ -s "$f" ] || { echo '{"points":[]}'; return; }
    awk -v cut="$((NOW - SYS_HIST_WIN))" '
      BEGIN{print "{\"points\":["}
      $1+0>=cut{
        if(n++) printf ","
        printf "{\"t\":%d,\"c\":%d,\"m\":%d,\"p\":%s}", $1+0, $2+0, $3+0, ($4==""?"0":$4)
      }
      END{print "]}"}
    ' "$f"
}

# $1 = force（1 = 强制刷写今日归档，供 ?proto_day 弹窗打开时用）
proto_accumulate() {
    if command -v flock >/dev/null 2>&1; then
        exec 9>/tmp/statusmon-proto.lock
        # busybox flock 无 -w 参数，用 timeout 包裹实现 10s 超时；超时则放弃本次防孤儿堆积
        timeout 10 flock -x 9 2>/dev/null || return 1
    fi
    _sm_nft_ensure
    _sm_cron_ensure
    TODAY=$(date +%F)
    THIS_MONTH=$(date +%Y-%m)
    mkdir -p "$PROTO_DIR" 2>/dev/null
    ARCHF="$PROTO_DIR/proto-$TODAY.json"
    [ -s "$ARCHF" ] || ARCHF=/dev/null
    MARCHF="$PROTO_DIR/month-$THIS_MONTH.json"
    [ -s "$MARCHF" ] || MARCHF=/dev/null
    [ -s "$PROTO_STATE" ] || : > "$PROTO_STATE"
    rm -f "$PROTO_STATE.new"
    nft list counters table netdev $SM_TABLE 2>/dev/null | awk \
      -v STATEF="$PROTO_STATE" -v ARCHF="$ARCHF" -v NEWSTATE="$PROTO_STATE.new" \
      -v TODAY="$TODAY" -v NOWS="$NOW" -v ARCHDIR="$PROTO_DIR" \
      -v MARCHF="$MARCHF" -v THIS_MONTH="$THIS_MONTH" \
      -v FLUSH_INT=30 -v FORCE="${1:-0}" '
function wr_json(day, rx, tx,   f, i, c, out, jc) {
  f = ARCHDIR "/proto-" day ".json"
  out = "{"; split("video game web download dns ntp other", jc, " ")
  for (i = 1; i <= 7; i++) { c = jc[i]; if (i > 1) out = out ","
    out = out "\"" c "\":{\"rx\":" rx[c]+0 ",\"tx\":" tx[c]+0 ",\"conn\":0}" }
  out = out "}"
  print out > f
}
function wr_month(mon, rx, tx,   f, i, c, out, jc) {
  f = ARCHDIR "/month-" mon ".json"
  out = "{"; split("video game web download dns ntp other", jc, " ")
  for (i = 1; i <= 7; i++) { c = jc[i]; if (i > 1) out = out ","
    out = out "\"" c "\":{\"rx\":" rx[c]+0 ",\"tx\":" tx[c]+0 ",\"conn\":0}" }
  out = out "}"
  print out > f
}
FILENAME == ARCHF && ARCHF != "/dev/null" {
  n = split($0, p, "\"")
  for (i = 2; i + 5 <= n; i += 8) { arx[p[i]] = substr(p[i+3],2)+0; atx[p[i]] = substr(p[i+5],2)+0 }
  next
}
FILENAME == MARCHF && MARCHF != "/dev/null" {
  n = split($0, p, "\"")
  for (i = 2; i + 5 <= n; i += 8) { mrx0[p[i]] = substr(p[i+3],2)+0; mtx0[p[i]] = substr(p[i+5],2)+0 }
  next
}
FILENAME == STATEF { st[$1] = $2; next }
$1 == "counter" { cn = $2; next }
cn != "" && /bytes/ { cur[cn] = $NF+0; cn = ""; next }
END {
  split("web video game dns ntp download other", cats, " ")
  oldday = st["DAY"] ""
  oldmonth = st["MONTH"] ""
  rollover = (oldday != "" && oldday != TODAY)
  fresh = (oldday == "")
  mrollover = (oldmonth != "" && oldmonth != THIS_MONTH)
  mfresh = (oldmonth == "")
  for (i = 1; i <= 7; i++) {
    c = cats[i]
    if (fresh || rollover) { nrx[c] = arx[c]+0; ntx[c] = atx[c]+0 }
    else { nrx[c] = st["RX_" c]+0; ntx[c] = st["TX_" c]+0 }
    if (fresh) { cul = 0; cdl = 0 }
    else {
      cul = cur[c "_ul"] - st["BASE_" c "_ul"]; cdl = cur[c "_dl"] - st["BASE_" c "_dl"]
      if (cul < 0) cul = 0; if (cdl < 0) cdl = 0
    }
    nrx[c] += cdl; ntx[c] += cul
    if (mrollover) { mrx[c] = 0; mtx[c] = 0 }
    else if (mfresh) { mrx[c] = mrx0[c]+0; mtx[c] = mtx0[c]+0 }
    else { mrx[c] = st["MRX_" c]+0; mtx[c] = st["MTX_" c]+0 }
    mrx[c] += cdl; mtx[c] += cul
  }
  nf = st["FLUSH"]+0
  needflush = FORCE || rollover || mrollover || nf == 0 || NOWS - nf >= FLUSH_INT
  if (rollover) { for (i = 1; i <= 7; i++) { c = cats[i]; orx[c] = st["RX_" c]+0; otx[c] = st["TX_" c]+0 }
    wr_json(oldday, orx, otx) }
  if (mrollover) { for (i = 1; i <= 7; i++) { c = cats[i]; mox[c] = st["MRX_" c]+0; mot[c] = st["MTX_" c]+0 }
    wr_month(oldmonth, mox, mot) }
  if (needflush) { wr_json(TODAY, nrx, ntx); wr_month(THIS_MONTH, mrx, mtx); newflush = NOWS } else newflush = nf
  print "DAY", TODAY > NEWSTATE
  print "MONTH", THIS_MONTH > NEWSTATE
  print "FLUSH", newflush > NEWSTATE
  for (i = 1; i <= 7; i++) { c = cats[i]
    print "BASE_" c "_ul", cur[c "_ul"]+0 > NEWSTATE
    print "BASE_" c "_dl", cur[c "_dl"]+0 > NEWSTATE
    print "RX_" c, nrx[c]+0 > NEWSTATE
    print "TX_" c, ntx[c]+0 > NEWSTATE
    print "MRX_" c, mrx[c]+0 > NEWSTATE
    print "MTX_" c, mtx[c]+0 > NEWSTATE }
}' "$ARCHF" "$MARCHF" "$PROTO_STATE" - 2>/dev/null
    mv -f "$PROTO_STATE.new" "$PROTO_STATE" 2>/dev/null
    wan_accumulate
}

# ===== WAN 接口月/日累计（v4.14：总量口径，cron 驱动）=====
WAN_STATE=/tmp/statusmon-wan-acct.txt

_sm_scale_cats() {
    printf '%s' "$1" | awk -v wr="$2" -v wt="$3" '
    {
      n=split($0,p,"\"")
      split("video game web download dns ntp other", jc, " ")
      cr=0; ct=0
      for(i=2;i+5<=n;i+=8){ rx[p[i]]=substr(p[i+3],2)+0; tx[p[i]]=substr(p[i+5],2)+0; cr+=rx[p[i]]; ct+=tx[p[i]] }
      if(cr+ct<=0){ print $0; exit }
      sr=(wr>0 && cr>0)?wr/cr:1; st=(wt>0 && ct>0)?wt/ct:1
      srr=0; stt=0
      for(i=1;i<=7;i++){
        c=jc[i]
        nrx[c]=int(rx[c]*sr+0.5); ntx[c]=int(tx[c]*st+0.5)
        srr+=nrx[c]; stt+=ntx[c]
      }
      maxr=jc[1]; maxt=jc[1]
      for(i=2;i<=7;i++){
        if(nrx[jc[i]]>nrx[maxr]) maxr=jc[i]
        if(ntx[jc[i]]>ntx[maxt]) maxt=jc[i]
      }
      if(wr>0){ nrx[maxr]+=wr-srr; if(nrx[maxr]<0) nrx[maxr]=0 }
      if(wt>0){ ntx[maxt]+=wt-stt; if(ntx[maxt]<0) ntx[maxt]=0 }
      out="{"
      for(i=1;i<=7;i++){
        c=jc[i]; if(i>1)out=out ","
        out=out "\"" c "\":{\"rx\":" nrx[c]+0 ",\"tx\":" ntx[c]+0 ",\"conn\":0}"
      }
      out=out "}"
      print out
    }'
}

wan_accumulate() {
    local IFACE CUR_RX CUR_TX LEFTF
    IFACE=$(_sm_wan_dev)
    [ -d "/sys/class/net/$IFACE" ] || return 0
    CUR_RX=$(awk -v n="$IFACE:" '$1==n{print $2; exit}' /proc/net/dev 2>/dev/null)
    CUR_TX=$(awk -v n="$IFACE:" '$1==n{print $10; exit}' /proc/net/dev 2>/dev/null)
    CUR_RX=${CUR_RX:-0}; CUR_TX=${CUR_TX:-0}
    mkdir -p "$PROTO_DIR" 2>/dev/null
    LEFTF="$PROTO_DIR/daily-pppoe-wan.json"
    [ -s "$LEFTF" ] || LEFTF=/dev/null
    TODAY=$(date +%F)
    THIS_MONTH=$(date +%Y-%m)
    WAN_TODAYF="$PROTO_DIR/wan-day-$TODAY.json"
    WAN_MONF="$PROTO_DIR/wan-month-$THIS_MONTH.json"
    [ -s "$WAN_STATE" ] || : > "$WAN_STATE"
    [ -s "$WAN_TODAYF" ] || WAN_TODAYF=/dev/null
    [ -s "$WAN_MONF" ] || WAN_MONF=/dev/null
    rm -f "$WAN_STATE.new"
    awk -v STATEF="$WAN_STATE" -v LEFTF="$LEFTF" -v TODAYF="$WAN_TODAYF" -v MONF="$WAN_MONF" \
      -v TODAY="$TODAY" -v THIS_MONTH="$THIS_MONTH" -v IFACE="$IFACE" \
      -v CUR_RX="$CUR_RX" -v CUR_TX="$CUR_TX" -v ARCHDIR="$PROTO_DIR" '
    FILENAME==STATEF && STATEF!="" { st[$1]=$2; next }
    FILENAME==LEFTF && LEFTF!="/dev/null" {
      n=split($0,p,"\"")
      for(i=2;i+1<=n;i++){
        k=p[i]
        if(k=="day") ld=p[i+2]
        if(k=="rx" && !sawrx){ lrx=substr(p[i+1],2)+0; sawrx=1 }
        if(k=="tx" && !sawtx){ ltx=substr(p[i+1],2)+0; sawtx=1 }
      }
      next
    }
    FILENAME==TODAYF && TODAYF!="/dev/null" {
      n=split($0,p,"\"")
      for(i=2;i+1<=n;i++){ if(p[i]=="rx")trx0=substr(p[i+1],2)+0; if(p[i]=="tx")ttx0=substr(p[i+1],2)+0 }
      next
    }
    FILENAME==MONF && MONF!="/dev/null" {
      n=split($0,p,"\"")
      for(i=2;i+1<=n;i++){ if(p[i]=="rx")mrx0=substr(p[i+1],2)+0; if(p[i]=="tx")mtx0=substr(p[i+1],2)+0 }
      next
    }
    END {
      oldday=st["DAY"] ""; oldmon=st["MONTH"] ""; oldif=st["IFACE"] ""
      base_rx=st["BASE_RX"]+0; base_tx=st["BASE_TX"]+0
      today_rx=st["TODAY_RX"]+0; today_tx=st["TODAY_TX"]+0
      month_rx=st["MONTH_RX"]+0; month_tx=st["MONTH_TX"]+0
      fresh=(oldday=="")
      if(fresh){
        if(ld!="" && ld==TODAY){ today_rx=lrx+0; today_tx=ltx+0 }
        else if(trx0+ttx0>0){ today_rx=trx0; today_tx=ttx0 }
        else { today_rx=0; today_tx=0 }
        if(mrx0+mtx0>0){ month_rx=mrx0+0; month_tx=mtx0+0 }
        else { month_rx=CUR_RX+0; month_tx=CUR_TX+0 }
        base_rx=CUR_RX+0; base_tx=CUR_TX+0
      } else {
        if(oldif!="" && oldif!=IFACE){ base_rx=CUR_RX+0; base_tx=CUR_TX+0 }
        dr=CUR_RX-base_rx; dt=CUR_TX-base_tx
        if(dr<0)dr=0; if(dt<0)dt=0
        if(oldday!="" && oldday!=TODAY){
          print "{\"rx\":" today_rx+0 ",\"tx\":" today_tx+0 "}" > (ARCHDIR "/wan-day-" oldday ".json")
          today_rx=0; today_tx=0
        }
        if(oldmon!="" && oldmon!=THIS_MONTH){
          print "{\"rx\":" month_rx+0 ",\"tx\":" month_tx+0 "}" > (ARCHDIR "/wan-month-" oldmon ".json")
          month_rx=0; month_tx=0
        }
        today_rx+=dr; today_tx+=dt
        month_rx+=dr; month_tx+=dt
        base_rx=CUR_RX+0; base_tx=CUR_TX+0
      }
      print "{\"rx\":" today_rx+0 ",\"tx\":" today_tx+0 "}" > (ARCHDIR "/wan-day-" TODAY ".json")
      print "{\"rx\":" month_rx+0 ",\"tx\":" month_tx+0 "}" > (ARCHDIR "/wan-month-" THIS_MONTH ".json")
      print "DAY", TODAY > (STATEF ".new")
      print "MONTH", THIS_MONTH > (STATEF ".new")
      print "IFACE", IFACE > (STATEF ".new")
      print "BASE_RX", base_rx+0 > (STATEF ".new")
      print "BASE_TX", base_tx+0 > (STATEF ".new")
      print "TODAY_RX", today_rx+0 > (STATEF ".new")
      print "TODAY_TX", today_tx+0 > (STATEF ".new")
      print "MONTH_RX", month_rx+0 > (STATEF ".new")
      print "MONTH_TX", month_tx+0 > (STATEF ".new")
    }
    ' "$WAN_STATE" "$LEFTF" "$WAN_TODAYF" "$WAN_MONF" 2>/dev/null
    [ -s "$WAN_STATE.new" ] && mv -f "$WAN_STATE.new" "$WAN_STATE"
}

# ===== 客户端流量持久累计引擎（v4.13，nft inet 动态 set 计数）=====
# 原理：inet/forward 动态 set 按客户端 IP 累计字节，不受 conntrack 过期清零影响；
#       每次采样与上次快照做差，增量按 MAC 归属累加到当日文件。
#       计数器回绕/超时重建：当前值小于快照时按重置处理，取当前值作为增量。
#       从 conntrack 口径切换过来时 src!=nft，首采只建基准不累加。
CLIENT_STATE=/tmp/statusmon-client-state.txt
CLIENT_RATEF=/tmp/statusmon-client-rate.txt

client_accumulate() {
    if command -v flock >/dev/null 2>&1; then
        exec 8>/tmp/statusmon-client.lock
        timeout 10 flock -x 8 2>/dev/null || return 1
    fi
    _sm_nft_cli_ensure
    TODAY=$(date +%F)
    TOTALF="$PROTO_DIR/client-total-$TODAY.txt"
    [ -d "$PROTO_DIR" ] || mkdir -p "$PROTO_DIR" 2>/dev/null
    LSE=/tmp/dhcp.leases
    [ -f "$LSE" ] || LSE=/dev/null
    CSIN="$CLIENT_STATE"; [ -s "$CSIN" ] || CSIN=/dev/null
    TOTIN="$TOTALF";     [ -s "$TOTIN" ] || TOTIN=/dev/null
    RIN="$CLIENT_RATEF"; [ -s "$RIN" ] || RIN=/dev/null
    N4F=/tmp/.sm_can4.$$
    N6F=/tmp/.sm_can6.$$
    NFTF=/tmp/.sm_nftcli.$$
    ip -4 neigh show 2>/dev/null > "$N4F"
    ip -6 neigh show 2>/dev/null > "$N6F"
    {
        echo "===ul4==="
        nft list set inet $SM_CLI_TABLE ul4 2>/dev/null
        echo "===dl4==="
        nft list set inet $SM_CLI_TABLE dl4 2>/dev/null
        echo "===ul6==="
        nft list set inet $SM_CLI_TABLE ul6 2>/dev/null
        echo "===dl6==="
        nft list set inet $SM_CLI_TABLE dl6 2>/dev/null
    } > "$NFTF"
    rm -f "$TOTALF.new" "$CLIENT_STATE.new" "$CLIENT_RATEF.new"
    awk -v LSE="$LSE" -v N4F="$N4F" -v N6F="$N6F" -v NFTF="$NFTF" \
      -v STATEIN="$CSIN" -v TOTALIN="$TOTIN" -v RATEIN="$RIN" \
      -v STATEF="$CLIENT_STATE" -v TOTALF="$TOTALF" -v RATEF="$CLIENT_RATEF" -v NOWS="$NOW" '
      function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
      function canon(v,  p,h,t,hn,tn,i,g,out){
        v=tolower(v)
        if(v~/::/){split(v,p,"::");hn=0;tn=0
          if(p[1]!="")hn=split(p[1],h,":")
          if(p[2]!="")tn=split(p[2],t,":")
          for(i=1;i<=hn;i++)g[i]=h[i]
          for(i=1;i<=8-hn-tn;i++)g[hn+i]="0"
          for(i=1;i<=tn;i++)g[8-tn+i]=t[i]
        } else split(v,g,":")
        out="";for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])}
        return out
      }
      FILENAME==LSE && LSE!="/dev/null"{
        if($3!="" && index($2,":")>0 && !($3 in macof))macof[$3]=$2
        next
      }
      (FILENAME==N4F||FILENAME==N6F) && FILENAME!="/dev/null"{
        ip=$1;mac=""
        for(i=2;i<NF;i++){if($i=="lladdr"&&mac=="")mac=$(i+1)}
        if(ip==""||mac==""||mac=="00:00:00:00:00:00")next
        if($NF!="REACHABLE"&&$NF!="DELAY"&&$NF!="PROBE"&&$NF!="STALE")next
        if(index(ip,":")){if(substr(ip,1,5)=="fe80:")next;ip=canon(ip)}
        if(!(ip in macof))macof[ip]=mac
        next
      }
      FILENAME==STATEIN && STATEIN!="/dev/null"{
        if($1~/^ts=/){lastts=substr($1,4)+0;next}
        if($1~/^src=/){lastsrc=substr($1,5);next}
        split($0,a,"|");if(a[1]!=""){lup[a[1]]=a[2]+0;ldn[a[1]]=a[3]+0}
        next
      }
      FILENAME==TOTALIN && TOTALIN!="/dev/null"{
        split($0,a,"|");if(a[1]!=""){crx[a[1]]=a[2]+0;ctx[a[1]]=a[3]+0}
        next
      }
      FILENAME==RATEIN && RATEIN!="/dev/null"{
        split($0,a,"|")
        if(a[1]!=""){
          wrts[a[1]]=a[2]+0;wrx[a[1]]=a[3]+0;wtx[a[1]]=a[4]+0
          wrr[a[1]]=a[5]+0;wrt[a[1]]=a[6]+0
        }
        next
      }
      FILENAME==NFTF && NFTF!="/dev/null"{
        if($0~/^===ul/){sec="ul";next}
        if($0~/^===dl/){sec="dl";next}
        for(i=1;i<=NF;i++){
          if($i=="counter" && i>1){
            ip=$(i-1); gsub(/[{},]/,"",ip)
            if(ip==""||ip=="elements"||ip=="="||ip=="{")continue
            b=0
            for(j=i;j<NF;j++) if($(j)=="bytes"){b=$(j+1)+0;break}
            if(index(ip,":"))ip=canon(ip)
            if(sec=="ul")up[ip]+=b; else dn[ip]+=b
            seenip[ip]=1
          }
        }
        next
      }
      END{
        have_state=(lastts+0)>0 && lastsrc=="nft"
        if(have_state){
          for(ip in seenip){
            m=macof[ip]; if(m=="")continue
            du=up[ip]-(lup[ip]+0); if(du<0)du=up[ip]+0
            dd=dn[ip]-(ldn[ip]+0); if(dd<0)dd=dn[ip]+0
            crx[m]+=dd;ctx[m]+=du
          }
        }
        for(m in crx)print m "|" crx[m]+0 "|" ctx[m]+0 > TOTALF ".new"
        close(TOTALF ".new")
        print "ts=" NOWS > STATEF ".new"
        print "src=nft" > STATEF ".new"
        for(ip in seenip)print ip "|" up[ip]+0 "|" dn[ip]+0 > STATEF ".new"
        close(STATEF ".new")
        for(m in crx){
          if(!(m in wrts)){
            print m "|" NOWS "|" crx[m]+0 "|" ctx[m]+0 "|0|0" > RATEF ".new"
          } else {
            wdtd=NOWS-(wrts[m]+0)
            if(wdtd>=6){
              wdrx=crx[m]-(wrx[m]+0);if(wdrx<0)wdrx=0
              wdtx=ctx[m]-(wtx[m]+0);if(wdtx<0)wdtx=0
              wrrate=0;wtrate=0
              if(wdtd>0){wrrate=int(wdrx/wdtd);wtrate=int(wdtx/wdtd)}
              print m "|" NOWS "|" crx[m]+0 "|" ctx[m]+0 "|" wrrate "|" wtrate > RATEF ".new"
            } else {
              print m "|" wrts[m]+0 "|" wrx[m]+0 "|" wtx[m]+0 "|" wrr[m]+0 "|" wrt[m]+0 > RATEF ".new"
            }
          }
        }
        close(RATEF ".new")
      }
      ' "$LSE" "$N4F" "$N6F" "$NFTF" "$CSIN" "$TOTIN" "$RIN" 2>/dev/null
    [ -s "$TOTALF.new" ] && mv -f "$TOTALF.new" "$TOTALF" 2>/dev/null
    [ -s "$CLIENT_STATE.new" ] && mv -f "$CLIENT_STATE.new" "$CLIENT_STATE" 2>/dev/null
    [ -s "$CLIENT_RATEF.new" ] && mv -f "$CLIENT_RATEF.new" "$CLIENT_RATEF" 2>/dev/null
    rm -f "$N4F" "$N6F" "$NFTF" "$TOTALF.new" "$CLIENT_STATE.new" "$CLIENT_RATEF.new"
    return 0
}

# ===== 查询端点分发 =====
# ===== 全局流量分类统计（?summary=1 / ?proto_day=YYYY-MM-DD）=====
# ?summary=1: 返回当前 conntrack 实时分类流量
# ?proto_day=YYYY-MM-DD: 返回历史某日的协议分类流量（从归档读取）
_qs_summary=$(echo "$QUERY_STRING" | sed -n 's/^summary=\([^&]*\).*/\1/p')
_qs_proto_day=$(echo "$QUERY_STRING" | sed -n 's/^proto_day=\([^&]*\).*/\1/p')
if [ -n "$_qs_proto_day" ]; then
    # 协议分类查询：先累计刷新（force 保证今日归档即时新鲜），再读归档
    proto_accumulate 1
    PROTO_FILE="$PROTO_DIR/proto-$_qs_proto_day.json"
    if [ -s "$PROTO_FILE" ]; then
        _pj=$(cat "$PROTO_FILE")
        _wf="$PROTO_DIR/wan-day-$_qs_proto_day.json"
        if [ -s "$_wf" ]; then
            _wr=$(awk '{n=split($0,p,"\"");for(i=2;i+1<=n;i++)if(p[i]=="rx"){print substr(p[i+1],2)+0;exit}}' "$_wf")
            _wt=$(awk '{n=split($0,p,"\"");for(i=2;i+1<=n;i++)if(p[i]=="tx"){print substr(p[i+1],2)+0;exit}}' "$_wf")
            _pj=$(_sm_scale_cats "$_pj" "${_wr:-0}" "${_wt:-0}")
        fi
        printf '%s\n' "$_pj"
    else
        echo '{"video":{"rx":0,"tx":0,"conn":0},"game":{"rx":0,"tx":0,"conn":0},"web":{"rx":0,"tx":0,"conn":0},"download":{"rx":0,"tx":0,"conn":0},"dns":{"rx":0,"tx":0,"conn":0},"ntp":{"rx":0,"tx":0,"conn":0},"other":{"rx":0,"tx":0,"conn":0}}'
    fi
    exit 0
fi
_qs_accumulate=$(echo "$QUERY_STRING" | sed -n 's/^accumulate=\([^&]*\).*/\1/p')
if [ -n "$_qs_accumulate" ]; then
    # cron 每分钟调用：只累计不返回数据（协议 nft counter + 客户端 nft 动态 set 差分）
    proto_accumulate 0
    client_accumulate
    _sm_sets_seed
    sys_hist_sample
    echo '{"result":"ok"}'
    exit 0
fi
_qs_sys_hist=$(echo "$QUERY_STRING" | sed -n 's/^sys_hist=\([^&]*\).*/\1/p')
if [ -n "$_qs_sys_hist" ]; then
    sys_hist_json
    exit 0
fi
if [ -n "$_qs_summary" ]; then
    CTF=/proc/net/nf_conntrack
    [ -f "$CTF" ] || CTF=/dev/null
    summary=$(awk -v CTF="$CTF" '
    function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
    function canon(v,  p,h,t,hn,tn,i,g,out){
      v=tolower(v)
      if(v~/::/){split(v,p,"::");hn=0;tn=0;if(p[1]!="")hn=split(p[1],h,":");if(p[2]!="")tn=split(p[2],t,":");for(i=1;i<=hn;i++)g[i]=h[i];for(i=1;i<=8-hn-tn;i++)g[hn+i]="0";for(i=1;i<=tn;i++)g[8-tn+i]=t[i]}
      else split(v,g,":")
      out="";for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])};return out
    }
    function classify(dport, proto,  p){
      p = dport + 0
      # 游戏（8567 网易系, 6881-6889, 9921-9922, 25565 MC, 27015 Steam, 3478 STUN）
      if(p==8567||p==8568||p==8569||(p>=6881&&p<=6889)||p==9921||p==9922||p==25565||p==27015||p==3478||p==43793)return "game"
      # DNS
      if(p==53)return "dns"
      # NTP
      if(p==123)return "ntp"
      # 下载/BT（51413 Transmission）
      if(p==51413)return "download"
      # v4.12：QUIC(udp 443) 为视频 App 实际载体，归视频（与 nft 计数口径一致）
      if(proto=="udp"&&(p==443||p==1935||(p>=8000&&p<=8999)))return "video"
      # 网页浏览（80/443/8443 先于 video 区间，修复 8443 被 8000-8999 吞没）
      if(p==80||p==443||p==8443)return "web"
      # 视频/直播（1935 RTMP, 8000-8999 流媒体）
      if(p==1935||(p>=8000&&p<=8999))return "video"
      return "other"
    }
    {
      s1="";dport="";b1="";b2="";proto=$3
      for(i=1;i<=NF;i++){
        if($i~/^src=/&&s1=="")s1=substr($i,5)
        if($i~/^dport=/&&dport=="")dport=substr($i,7)
        if($i~/^bytes=/){if(b1=="")b1=substr($i,7);else if(b2=="")b2=substr($i,7)}
      }
      if(s1=="")next
      if(dport=="")next
      # 统计所有连接的流量（不限方向），按 dport 分类
      cat=classify(dport,proto)
      tx[cat]+=b1+0
      rx[cat]+=b2+0
      cnt[cat]++
    }
    END{
      printf "{"
      cats[1]="video";cats[2]="game";cats[3]="web";cats[4]="download";cats[5]="dns";cats[6]="ntp";cats[7]="other"
      for(i=1;i<=7;i++){
        c=cats[i]
        if(i>1)printf ","
        printf "\"%s\":{\"rx\":%d,\"tx\":%d,\"conn\":%d}",c,rx[c]+0,tx[c]+0,cnt[c]+0
      }
      printf "}"
    }' "$CTF" 2>/dev/null)
    echo "$summary"
    exit 0
fi

# ===== 客户端连接详情查询（?client=IP 或 ?mac=MAC）=====
# ?mac=MAC 时自动查找该 MAC 的所有 IP（v4+v6 邻居表），返回所有 conntrack 连接
QUERY_VAL=""
QUERY_MODE=""
if [ -n "$QUERY_STRING" ]; then
    _qs_mac=$(echo "$QUERY_STRING" | sed -n 's/^mac=\([^&]*\).*/\1/p')
    _qs_ip=$(echo "$QUERY_STRING" | sed -n 's/^client=\([^&]*\).*/\1/p')
    if [ -n "$_qs_mac" ]; then
        QUERY_MODE="mac"; QUERY_VAL=$(printf '%b' "$(echo "$_qs_mac" | sed 's/%/\\x/g')")
    elif [ -n "$_qs_ip" ]; then
        QUERY_MODE="ip"; QUERY_VAL=$(printf '%b' "$(echo "$_qs_ip" | sed 's/%/\\x/g')")
    fi
fi
if [ -n "$QUERY_MODE" ]; then
    CTF=/proc/net/nf_conntrack
    [ -f "$CTF" ] || CTF=/dev/null
    # 如果是 MAC 模式，先查邻居表获取该 MAC 的所有 IP
    if [ "$QUERY_MODE" = "mac" ]; then
        QUERY_IPS=$(ip neigh show 2>/dev/null | grep -i "$QUERY_VAL" | grep -v fe80 | awk '{print $1}' | tr '\n' ' ')
    else
        QUERY_IPS="$QUERY_VAL"
    fi
    conns=$(awk -v ips="$QUERY_IPS" -v CTF="$CTF" '
    function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
    function canon(v,  p,h,t,hn,tn,i,g,out){
      v=tolower(v)
      if(v~/::/){split(v,p,"::");hn=0;tn=0;if(p[1]!="")hn=split(p[1],h,":");if(p[2]!="")tn=split(p[2],t,":");for(i=1;i<=hn;i++)g[i]=h[i];for(i=1;i<=8-hn-tn;i++)g[hn+i]="0";for(i=1;i<=tn;i++)g[8-tn+i]=t[i]}
      else split(v,g,":")
      out="";for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])};return out
    }
    BEGIN {
        first = 1; printf "["
        nip = split(ips, iparr, " ")
        for (i = 1; i <= nip; i++) {
            ip = iparr[i]
            if (index(ip, ":")) ip = canon(ip)
            ipset[ip] = 1
        }
    }
    {
        proto = $3; nf = NF
        state = ""
        for (i = 1; i <= nf; i++) {
            if ($i ~ /^(ESTABLISHED|TIME_WAIT|CLOSE_WAIT|CLOSE|SYN_RECV|FIN_WAIT|LISTEN|NONE|OFFLOAD|\[ESTABLISHED\]|\[TIME_WAIT\]|\[CLOSE_WAIT\]|\[CLOSE\]|\[SYN_RECV\]|\[FIN_WAIT\]|\[OFFLOAD\]|\[ASSURED\])$/) {
                if (state == "") { state = $i; gsub(/[][]/, "", state) }
            }
        }
        src = ""; dst = ""; sport = ""; dport = ""; pkts = "0"; byts = "0"
        for (i = 1; i <= nf; i++) {
            if ($i ~ /^src=/ && src == "") { src = substr($i, 5) }
            if ($i ~ /^dst=/ && dst == "") { dst = substr($i, 5) }
            if ($i ~ /^sport=/ && sport == "") { sport = substr($i, 7) }
            if ($i ~ /^dport=/ && dport == "") { dport = substr($i, 7) }
        }
        if (src == "") next
        # IPv6 地址规范化后匹配
        csrc = src
        if (index(csrc, ":")) csrc = canon(csrc)
        if (csrc in ipset) {
            # 只返回活跃连接（TCP=ESTABLISHED+OFFLOAD, UDP=ASSURED+OFFLOAD），与列表口径一致
        if (state != "ESTABLISHED" && state != "OFFLOAD" && !(state == "ASSURED" && proto == "udp")) next
            for (i = 1; i <= nf; i++) {
                if ($i ~ /^packets=/) { pkts = substr($i, 9); break }
            }
            for (i = 1; i <= nf; i++) {
                if ($i ~ /^bytes=/) { byts = substr($i, 7); break }
            }
            svc = dport
            if (dport == "80") svc = "HTTP"
            else if (dport == "443") svc = "HTTPS"
            else if (dport == "53") svc = "DNS"
            else if (dport == "22") svc = "SSH"
            else if (dport == "8080") svc = "HTTP-Alt"
            else if (dport == "123") svc = "NTP"
            else if (dport == "1900") svc = "SSDP"
            else if (dport == "5353") svc = "mDNS"
            if (!first) printf ","
            first = 0
            printf "{\"proto\":\"%s\",\"state\":\"%s\",\"dst\":\"%s\",\"dport\":\"%s\",\"sport\":\"%s\",\"svc\":\"%s\",\"pkts\":%s,\"bytes\":%s}", proto, state, dst, dport, sport, svc, pkts+0, byts+0
        }
    }
    END { printf "]" }
    ' "$CTF" 2>/dev/null)
    echo "$conns"
    exit 0
fi

PREV_TS=0; PREV_NET=""; PREV_CLIENT=""
if [ -f "$STATE" ]; then
    PREV_TS=$(grep -o '"ts":[0-9]*' "$STATE" 2>/dev/null | head -1 | cut -d: -f2)
    PREV_NET=$(grep -o '"net":"[^"]*"' "$STATE" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '"')
    PREV_CLIENT=$(grep -o '"clients":"[^"]*"' "$STATE" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '"')
fi
# 注：v4.6 速率计算移至前端，CGI 不再使用 DT/PREV_NET/PREV_CLIENT 做速率计算；
# 但仍需保存 net/clients 状态供客户端累计流量等使用
DT=$((NOW - PREV_TS))
[ "$DT" -lt 1 ] && DT=1

# ===== 系统 =====
hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null)
kernel=$(uname -r 2>/dev/null)
uptime_s=$(awk '{printf "%.0f", $1}' /proc/uptime 2>/dev/null)
load1=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
load5=$(awk '{print $2}' /proc/loadavg 2>/dev/null)
load15=$(awk '{print $3}' /proc/loadavg 2>/dev/null)
board=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "unknown")
cpu_model=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//' || echo "unknown")
cpu_cores=$(grep -c processor /proc/cpuinfo 2>/dev/null || echo 1)

# CPU 温度（v4.10）：优先 x86_pkg_temp（内核 x86 包温度，与 LuCI 首页口径一致；
# 本机实测 x86_pkg_temp=coretemp Package=35C，而 thermal_zone0=acpitz=41C 是主板 ACPI 传感器非 CPU 本体）
# 其次 coretemp hwmon 的 Package id 0，最后回退首个 thermal zone / hwmon
temp_c="null"
for z in /sys/class/thermal/thermal_zone*; do
    [ -f "$z/type" ] && [ "$(cat "$z/type" 2>/dev/null)" = "x86_pkg_temp" ] && [ -f "$z/temp" ] && {
        t=$(cat "$z/temp" 2>/dev/null)
        [ -n "$t" ] && { temp_c=$(awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'); break; }
    }
done
if [ "$temp_c" = "null" ]; then
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] && [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" ] && [ -f "$h/temp1_input" ] && {
            t=$(cat "$h/temp1_input" 2>/dev/null)
            [ -n "$t" ] && { temp_c=$(awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'); break; }
        }
    done
fi
if [ "$temp_c" = "null" ]; then
    for z in /sys/class/thermal/thermal_zone*/temp; do
        [ -f "$z" ] && { t=$(cat "$z" 2>/dev/null); [ -n "$t" ] && { temp_c=$(awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'); break; }; }
    done
fi
[ "$temp_c" = "null" ] && for h in /sys/class/hwmon/hwmon*/temp1_input; do
    [ -f "$h" ] && { t=$(cat "$h" 2>/dev/null); [ -n "$t" ] && { temp_c=$(awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'); break; }; }
done

# CPU 使用率：跨请求差分采样（v4.8）
# BusyBox sleep 不支持小数秒，请求内 sleep 0.5 必然失败（日志刷屏 + 窗口退化 ~1ms，
# 4 核量化出 0/25/50/75/100% 失真值）。改为本次 /proc/stat 计数器与上次请求存档做差，
# 采样窗口即轮询间隔（约 2s）；窗口不足 1s（delta < 核数×100 tick）或计数器回绕时沿用上次结果。
# 状态文件 /tmp/statusmon-cpu.state：total idle usage 三个整数，原子替换写入
cpu_usage=0
CPU_STATE=/tmp/statusmon-cpu.state
read -r _ cu_u2 cu_n2 cu_s2 cu_i2 cu_w2 cu_q2 cu_sq2 cu_st2 _ _ < /proc/stat 2>/dev/null
if [ -n "$cu_i2" ]; then
    cu_tot2=$((cu_u2 + cu_n2 + cu_s2 + cu_i2 + cu_w2 + cu_q2 + cu_sq2 + cu_st2))
    cu_idl2=$((cu_i2 + cu_w2))
    cu_pt=0; cu_pi=0; cu_pu=0
    [ -f "$CPU_STATE" ] && read -r cu_pt cu_pi cu_pu < "$CPU_STATE" 2>/dev/null
    case "$cu_pt" in ''|*[!0-9]*) cu_pt=0 ;; esac
    case "$cu_pi" in ''|*[!0-9]*) cu_pi=0 ;; esac
    case "$cu_pu" in ''|*[!0-9]*) cu_pu=0 ;; esac
    cu_dt=$((cu_tot2 - cu_pt))
    cu_di=$((cu_idl2 - cu_pi))
    cu_min=$((cpu_cores * 100))
    if [ "$cu_pt" -eq 0 ] || [ "$cu_dt" -lt 0 ]; then
        # 首次运行 / 计数器回绕（重启）：仅重建基线，沿用上次结果
        cpu_usage=$cu_pu
    elif [ "$cu_dt" -ge "$cu_min" ]; then
        cpu_usage=$(( (cu_dt - cu_di) * 100 / cu_dt ))
    else
        # 窗口不足 1s（并发轮询密集）：沿用上次结果
        cpu_usage=$cu_pu
    fi
    printf '%s %s %s\n' "$cu_tot2" "$cu_idl2" "$cpu_usage" > "$CPU_STATE.$$" 2>/dev/null && mv -f "$CPU_STATE.$$" "$CPU_STATE" 2>/dev/null
    rm -f "$CPU_STATE.$$" 2>/dev/null
fi

# ===== 内存 =====
mem_total=0; mem_free=0; mem_avail=0; mem_cached=0; mem_buf=0
while read -r line; do
    case "$line" in
        MemTotal:*) mem_total=$(echo "$line" | awk '{print $2}') ;;
        MemFree:*) mem_free=$(echo "$line" | awk '{print $2}') ;;
        MemAvailable:*) mem_avail=$(echo "$line" | awk '{print $2}') ;;
        Cached:*) mem_cached=$(echo "$line" | awk '{print $2}') ;;
        Buffers:*) mem_buf=$(echo "$line" | awk '{print $2}') ;;
    esac
done < /proc/meminfo 2>/dev/null
mem_used=$((mem_total - mem_avail))

# ===== 协议统计 =====
# v4.10：/proc/net/snmp 单次 awk 提取（此前 12 个 grep/echo|awk 进程 spawn）
# 各协议两行（表头+数值），awk 后行覆盖前行 → 取到数值行，与旧 tail -1 语义一致
proto_tcp_curr=0; proto_tcp_total=0; proto_udp=0; proto_icmp=0; proto_ip_total=0
proto_tcp_ret=0; proto_udp_ret=0
set -- $(awk '
  /^Tcp:/{t10=$10;t11=$11;t13=$13}
  /^Udp:/{u2=$2;u4=$4}
  /^Icmp:/{i2=$2}
  /^Ip:/{p3=$3}
  END{print t10+0,t11+0,t13+0,u2+0,u4+0,i2+0,p3+0}' /proc/net/snmp 2>/dev/null)
[ -n "${1:-}" ] && proto_tcp_curr=$1
[ -n "${2:-}" ] && proto_tcp_total=$2
[ -n "${3:-}" ] && proto_tcp_ret=$3
[ -n "${4:-}" ] && proto_udp=$4
[ -n "${5:-}" ] && proto_udp_ret=$5
[ -n "${6:-}" ] && proto_icmp=$6
[ -n "${7:-}" ] && proto_ip_total=$7
ct_total=0
[ -f /proc/sys/net/netfilter/nf_conntrack_count ] && ct_total=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
[ -z "$ct_total" ] && ct_total=0
ct_max=0
[ -f /proc/sys/net/netfilter/nf_conntrack_max ] && ct_max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 0)
[ -z "$ct_max" ] && ct_max=0

# conntrack 协议分布
# TCP 活跃 = ESTABLISHED 或 [OFFLOAD]（勿用 [ASSURED] 覆盖 TCP 状态）
# UDP 活跃 = [ASSURED] 或 [OFFLOAD]（UDP 无 ESTABLISHED）
# ICMP 无状态概念，统计全部条目
# 外部连接 = 活跃连接中原始 src 或 dst 任一为公网（含 LAN 出站与公网入站）
ct_tcp_estab=0; ct_tcp_total=0; ct_udp=0; ct_udp_total=0; ct_icmp=0; ct_external=0
if [ -f /proc/net/nf_conntrack ]; then
    _own_ip=$(ip -o addr show 2>/dev/null | awk '{
      for(i=1;i<=NF;i++) if($i=="inet"||$i=="inet6"){a=$(i+1); sub(/\/.*/,"",a); sub(/%.*/,"",a); if(a!=""&&a!="::1"&&a!="127.0.0.1") print a}
    }' | tr '\n' '|')
    _lan6=$(ip -o addr show 2>/dev/null | awk '/inet6/{
      a=$4; sub(/\/.*/,"",a); sub(/%.*/,"",a)
      if(a==""||a=="::1"||index(a,"fe80")==1) next
      n=split(a,h,":"); p=h[1]":"h[2]":"h[3]":"h[4]
      if(p!=""&&p!=":::") print p
    }' | tr '\n' '|')
    _proto_stats=$(awk -v OWN="|${_own_ip}" -v LAN6="|${_lan6}" '
      function z(s){ gsub(/^0+/,"",s); return (s==""?"0":s) }
      function p4(s, n,h){ n=split(s,h,":"); return z(h[1])":"z(h[2])":"z(h[3])":"z(h[4]) }
      function is_int(ip){
        if(ip=="") return 1
        if(index(OWN,"|" ip "|")>0) return 1
        if(index(ip,".")>0){
          if(substr(ip,1,3)=="10.") return 1
          if(substr(ip,1,4)=="127.") return 1
          if(substr(ip,1,8)=="169.254.") return 1
          if(substr(ip,1,8)=="192.168.") return 1
          if(substr(ip,1,4)=="172."){
            seg=substr(ip,5)+0
            if(seg>=16&&seg<=31) return 1
          }
          if(substr(ip,1,4)=="100."){
            seg=substr(ip,5)+0
            if(seg>=64&&seg<=127) return 1
          }
          return 0
        }
        if(substr(ip,1,5)=="fe80:"||ip=="::1") return 1
        if(substr(ip,1,2)=="fc"||substr(ip,1,2)=="fd") return 1
        if(index(LAN6,"|" p4(ip) "|")>0) return 1
        return 0
      }
      {
      p=$3; s1=""; d1=""; off=0; assured=0
      for(i=1;i<=NF;i++){
        if($i~/^src=/&&s1=="") s1=substr($i,5)
        if($i~/^dst=/&&d1=="") d1=substr($i,5)
        if($i=="[OFFLOAD]"||$i=="OFFLOAD") off=1
        if($i=="[ASSURED]") assured=1
      }
      tcp_st=$6
      active=0
      if(p=="tcp"){
        tcp++
        if(tcp_st=="ESTABLISHED"||off){tcp_e++; active=1}
      } else if(p=="udp"){
        udp++
        if(assured||off){udp_e++; active=1}
      } else if(p=="icmp"||p=="icmpv6"){
        icmp++; active=1
      }
      if(active && (!is_int(s1) || !is_int(d1))) ext++
    } END{print tcp_e+0, tcp+0, udp_e+0, udp+0, icmp+0, ext+0}' /proc/net/nf_conntrack 2>/dev/null)
    ct_tcp_estab=$(echo "$_proto_stats" | awk '{print $1}')
    ct_tcp_total=$(echo "$_proto_stats" | awk '{print $2}')
    ct_udp=$(echo "$_proto_stats" | awk '{print $3}')
    ct_udp_total=$(echo "$_proto_stats" | awk '{print $4}')
    ct_icmp=$(echo "$_proto_stats" | awk '{print $5}')
    ct_external=$(echo "$_proto_stats" | awk '{print $6}')
fi

# ===== 网络接口（物理 + LAN + WAN + WiFi + pppoe*）=====
# v4.10 性能优化：所有 sysfs/ip/uci 读取批量预取为 shell 变量，循环内零进程 spawn
# （此前每接口 10+ spawn，且每个 ethX 跑两次 uci show network —— 是轮询开销主因）
net_ifs="[]"
net_lines=""
net_state=""

# 1) 全部接口计数器：一次 awk 读 /proc/net/dev（与 /sys/class/net/*/statistics 同源）
eval "$(awk 'NR>2{n=$1;sub(/:$/,"",n);gsub(/[^a-zA-Z0-9_]/,"_",n);
  printf "IFC_%s=\"%s %s %s %s\"\n", n, $2, $10, $3, $11}' /proc/net/dev 2>/dev/null)"
# 2) operstate：一次 awk 扫全部 sysfs 文件（carrier 不能 bulk 读 —— 虚拟设备如 dummy0
#    的 carrier 读返回 EINVAL 会让 BusyBox awk 直接退出，故 carrier 在循环内按需 cat）
eval "$(awk '{f=FILENAME;sub(/.*\/net\//,"",f);sub(/\/operstate$/,"",f);gsub(/[^a-zA-Z0-9_]/,"_",f);
  printf "OPST_%s=\"%s\"\n", f, $0}' /sys/class/net/*/operstate 2>/dev/null)"
# 3) 地址：ip -o 一次全取（v4 取前 3 个、v6 全局取前 2 个，与旧逐口解析口径一致；
#    PPP peer 行 $4 为裸 IP，等价旧正则的可选掩码语义）
eval "$(ip -o -4 addr show 2>/dev/null | awk '{n=$2;gsub(/[^a-zA-Z0-9_]/,"_",n);a=$4;sub(/ .*/,"",a);
  if(A4[n]=="")A4[n]=a; else if(c4[n]<2)A4[n]=A4[n]", "a; c4[n]++}
  END{for(n in A4)printf "ADR4_%s=\"%s\"\n", n, A4[n]}')"
eval "$(ip -o -6 addr show 2>/dev/null | awk '$5=="scope"&&$6=="global"{n=$2;gsub(/[^a-zA-Z0-9_]/,"_",n);
  if(A6[n]=="")A6[n]=$4; else if(c6[n]<1)A6[n]=A6[n]", "$4; c6[n]++}
  END{for(n in A6)printf "ADR6_%s=\"%s\"\n", n, A6[n]}')"
# 4) UCI 一次性预取：PPPoE 各接口的底层 device + 全部 device 引用
_pppoe_base_devs=""
for _sec in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.]*\)\.proto='pppoe'/\1/p"); do
    _pd=$(uci get "network.$_sec.device" 2>/dev/null)
    [ -n "$_pd" ] && { _pppoe_base_devs="$_pppoe_base_devs $_pd"; eval "PPPB_${_sec//-/_}='$_pd'"; }
done
_uci_all=$(uci show network 2>/dev/null | grep "device=")

for iface_dir in /sys/class/net/*; do
    iface=$(basename "$iface_dir")
    case "$iface" in
        eth*|wlan*|ra*|br-lan|wan|br-wan|pppoe-*|ppp-*) ;;
        *) continue ;;
    esac
    _m=${iface//-/_}; _m=${_m//./_}
    # 状态（operstate 为 unknown/down 时参考 carrier，同旧逻辑；carrier 逐口读，
    # 虚拟设备读返回 EINVAL 时 cat 失败→空值→不误判）
    eval "operstate=\${OPST_${_m}:-unknown}"
    if [ "$operstate" = "unknown" ] || [ "$operstate" = "down" ]; then
        if [ -f "$iface_dir/carrier" ]; then
            carrier=$(cat "$iface_dir/carrier" 2>/dev/null)
            [ "$carrier" = "1" ] && operstate="up"
        fi
    fi
    # 计数器（rx tx rx_pkts tx_pkts）
    eval "_cnt=\${IFC_${_m}:-0 0 0 0}"
    set -- $_cnt
    rx_bytes=${1:-0}; tx_bytes=${2:-0}; rx_pkts=${3:-0}; tx_pkts=${4:-0}
    # 地址
    eval "ip4=\${ADR4_${_m}:-}"
    eval "ip6=\${ADR6_${_m}:-}"
    ip_addr="$ip4"
    [ -n "$ip6" ] && ip_addr="${ip4:+$ip4, }$ip6"
    # 接口类型
    iface_type="physical"
    case "$iface" in
        br-lan) iface_type="LAN" ;;
        pppoe-*|ppp-*) iface_type="WAN" ;;
        wan|br-wan) iface_type="WAN" ;;
        wlan*|ra*) iface_type="WIFI" ;;
    esac
    # v4.13：PPPoE 用逻辑口自身计数器（IP payload，与运营商/协议分类口径一致）
    # UCI 识别：ethX 是某个非 PPPoE WAN 接口的底层设备时标记为 WAN（如 IPTV 专线 eth1=wan2）
    # 但排除 PPPoE 接口的底层物理口（如 eth0 是 pppoe-wan 的载体，流量已通过 pppoe-wan 体现，不重复计为 WAN）
    # v4.10：纯 shell 判断（旧实现每个 ethX 跑两次 uci show + grep 管道）
    if [ "$iface_type" = "physical" ]; then
        case "$iface" in
            eth*)
                _rest=${iface#eth}
                case "$_rest" in
                    ''|*[!0-9]*) ;;
                    *)
                        _is_pppoe_base=0
                        for _pd in $_pppoe_base_devs; do [ "$_pd" = "$iface" ] && _is_pppoe_base=1; done
                        if [ "$_is_pppoe_base" = "0" ]; then
                            # device 引用且非 lan 段（lan 段引用优先视为 LAN 底层口）
                            case "$_uci_all" in
                                *"network.lan.device='$iface'"*) ;;
                                *"device='$iface'"*) iface_type="WAN" ;;
                            esac
                        fi
                        ;;
                esac
                ;;
        esac
    fi
    # v4.6：速率计算移至前端，CGI 不再计算 rx_rate/tx_rate
    net_lines="$net_lines{\"name\":\"$iface\",\"type\":\"$iface_type\",\"state\":\"$operstate\",\"rx\":$rx_bytes,\"tx\":$tx_bytes,\"rx_pkts\":$rx_pkts,\"tx_pkts\":$tx_pkts,\"ip\":\"$ip_addr\",\"ip4\":\"$ip4\",\"ip6\":\"$ip6\"},"
    net_state="${net_state}${iface}:rx=${rx_bytes},tx=${tx_bytes};"
done
[ -n "$net_lines" ] && net_lines=${net_lines%,} && net_ifs="[$net_lines]"

# ===== 客户端（DHCP 租约底册 + 邻居状态 + conntrack 流量，按设备合并）=====
# 口径与首页设备列表一致：以 /tmp/dhcp.leases 为设备清单底册（含主机名），
# 叠加邻居表状态：REACHABLE/DELAY/PROBE=活跃（近期有流量）、STALE=空闲（在线但静默）、
# 无邻居条目的租约设备=离线；FAILED/INCOMPLETE 仍排除。
# 同一设备（按 MAC）的 v4/v6 地址与 conntrack 流量合并为一行。
# v4.11：主查询每次请求都触发持久累计（前端 2s 轮询差分需要连续新鲜的累计值；
#        旧版 2s 节流与轮询同频导致 0/2x 速率跳变，故去掉节流，由 flock 串行化）
CLIENT_TOTALF="$PROTO_DIR/client-total-$(date +%F).txt"
client_accumulate
clients="[]"
client_lines=""
client_state=""

LSE=/tmp/dhcp.leases
[ -f "$LSE" ] || LSE=/dev/null

TMPL4=/tmp/.sm_neigh4.$$
TMPL6=/tmp/.sm_neigh6.$$
trap 'rm -f "$TMPL4" "$TMPL6"' EXIT
ip -4 neigh show 2>/dev/null > "$TMPL4"
ip -6 neigh show 2>/dev/null > "$TMPL6"

CTF=/proc/net/nf_conntrack
[ -f "$CTF" ] || CTF=/dev/null

# 一次 awk 扫描四个文件：租约(设备底册) -> conntrack(IP聚合) -> v4/v6邻居(状态+IP归属)
CLIENTS=$(awk -v CTF="$CTF" -v LSE="$LSE" '
function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
function canon(v,  p,h,t,hn,tn,i,g,out){
  v=tolower(v)
  if(v~/::/){
    split(v,p,"::");hn=0;tn=0
    if(p[1]!="")hn=split(p[1],h,":")
    if(p[2]!="")tn=split(p[2],t,":")
    for(i=1;i<=hn;i++)g[i]=h[i]
    for(i=1;i<=8-hn-tn;i++)g[hn+i]="0"
    for(i=1;i<=tn;i++)g[8-tn+i]=t[i]
  } else split(v,g,":")
  out=""
  for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])}
  return out
}
# --- 文件1: DHCP 租约（dnsmasq 格式: 到期 MAC IP 主机名 clientid） ---
FILENAME==LSE{
  if($2!="" && index($2,":")>0){
    if($4!="" && $4!="*")host[$2]=$4
    lip[$2]=$3
    if(!($2 in seen)){seen[$2]=1;order[++k]=$2}
  }
  next
}
# --- 文件2: conntrack 聚合（客户端发起: 发送=orig_bytes, 接收=reply_bytes） ---
# 只统计请求方向（s1=发起方），不统计返回方向（s2=服务端），避免连接数翻倍
# 流量(up/dn)统计所有连接；连接数(cn)只统计活跃连接：
#   TCP=ESTABLISHED+OFFLOAD, UDP=ASSURED+OFFLOAD
FILENAME==CTF{
  s1="";s2="";b1="";b2="";ctst="";proto=""
  for(i=1;i<=NF;i++){
    if($i~/^src=/){if(s1=="")s1=substr($i,5);else if(s2=="")s2=substr($i,5)}
    else if($i~/^bytes=/){if(b1=="")b1=substr($i,7);else if(b2=="")b2=substr($i,7)}
    if($i~/^(ESTABLISHED|OFFLOAD|\[ESTABLISHED\]|\[OFFLOAD\]|\[ASSURED\])$/){ctst=$i;gsub(/[][]/,"",ctst)}
  }
  proto=$3
  if(s1=="")next
  if(index(s1,":"))s1=canon(s1)
  up[s1]+=b1;dn[s1]+=b2
  # TCP 活跃: ESTABLISHED+OFFLOAD; UDP 活跃: ASSURED+OFFLOAD
  if(ctst=="ESTABLISHED"||ctst=="OFFLOAD"||(ctst=="ASSURED"&&proto=="udp"))cn[s1]++
  next
}
# --- 文件3/4: 邻居表（含 STALE=空闲） ---
{
  ip=$1;mac="";dev=""
  for(i=2;i<NF;i++){
    if($i=="dev"&&dev=="")dev=$(i+1)
    else if($i=="lladdr"&&mac=="")mac=$(i+1)
  }
  st=$NF
  if(ip=="")next
  if(st!="REACHABLE"&&st!="DELAY"&&st!="PROBE"&&st!="STALE")next
  if(mac==""||mac=="00:00:00:00:00:00")next
  ver=4
  if(index(ip,":")){
    if(substr(ip,1,5)=="fe80:")next
    # v4.17：IPv6 只认近期可达，丢掉 STALE 残留（关 IPv6 / 前缀轮换后旧 SLAAC 会挂很久）
    if(st=="STALE")next
    ver=6
  }
  if(dev!="br-lan"&&dev!~/^(br-|wlan|ra|ath|apcli)/)next
  if(!(mac in seen)){seen[mac]=1;order[++k]=mac}
  if(st!="STALE")act[mac]=1
  if(ver==4){
    if(!(mac in m4))m4[mac]=ip
  } else {
    if(m6[mac]=="")m6[mac]=ip;else m6[mac]=m6[mac] "," ip
  }
  key=ip
  if(ver==6)key=canon(ip)
  if(key in cn)totconn[mac]+=cn[key]
  if(key in dn)totrx[mac]+=dn[key]
  if(key in up)tottx[mac]+=up[key]
}
END{
  for(i=1;i<=k;i++){
    m=order[i]
    st="offline"
    if(m in act)st="active"
    else if((m in m4)||(m in m6))st="idle"
    nm=(m in host)?host[m]:""
    v4=""
    if(m in m4)v4=m4[m]
    else if(m in lip)v4=lip[m]
    v6=(m in m6)?m6[m]:""
    ip=v4
    if(ip==""){if(v6!=""){split(v6,t6,",");ip=t6[1]}}
    ver=(v4!="")?((v6!="")?"46":"4"):"6"
    # 离线设备（无邻居条目）也查一次租约 IP 的 conntrack 残留计数
    if(!(m in m4)&&v4!=""){
      if(v4 in cn)totconn[m]+=cn[v4]
      if(v4 in dn)totrx[m]+=dn[v4]
      if(v4 in up)tottx[m]+=up[v4]
    }
    printf "%s|%s|%s|%s|%s|%s|%d|%d|%d\n",nm,ip,m,st,ver,v6,totconn[m]+0,totrx[m]+0,tottx[m]+0
  }
}' "$LSE" "$CTF" "$TMPL4" "$TMPL6" 2>/dev/null)

while IFS='|' read -r cname cip cmac cst cver cv6 cconn crx ctx; do
    [ -z "$cmac" ] && continue
