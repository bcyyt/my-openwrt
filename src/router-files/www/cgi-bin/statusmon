#!/bin/sh
# statusmon v4.21 — OpenWrt 系统状态数据采集 CGI
# 部署到 /www/cgi-bin/statusmon
# v4.1 修复：ip neigh 字段解析（MAC=$5/状态=末字段）、CPU 采样公式、
#           conntrack 双向归并 + IPv6 地址规范化匹配、活跃客户端过滤（REACHABLE/DELAY/PROBE）
# v4.2 修复：tx 速率解析（state 条目格式 key:rx=N,tx=M 需 sed 提取，不能用 key:tx= 匹配）、
#           fe80:: 排除修正、接口 IPv4 兼容 PPP peer 格式（无 /掩码）
# v4.3 修复：firewall 改用 nft fw4 规则检测（fw4 非常常驻进程）；服务列表新增 rtp2httpd
# v4.4 变更：客户端口径与首页对齐 —— DHCP 租约为设备底册（含主机名），
#           状态分 活跃/空闲(STALE)/离线，同设备 v4+v6 合并一行
# v4.5 变更：新增 WAN 每日流量统计（单接口）
# v4.6 变更：速率计算全部移至前端 —— CGI 不再计算 rx_rate/tx_rate，
#           只返回累计字节与 timestamp，前端各页独立计算速率，
#           避免多页面并发写 state 导致 DT 被打乱；
#           WAN 流量统计改为多接口分别统计（pppoe-wan + wan2 等）
# v4.7 变更：PPPoE 接口改用底层物理口计数器（UCI 查 device，逻辑口 rx 只含 IP payload 严重偏低）；
#           协议统计改 conntrack 实时连接数（TCP 活跃=ESTABLISHED+OFFLOAD，UDP 活跃=ASSURED+OFFLOAD，外部连接）；
#           新增 ?summary=1 / ?proto_day=YYYY-MM-DD / ?mac=MAC / ?client=IP 端点；修复客户端 b2 赋值 bug
# v4.8 修复：CPU 使用率改为跨请求差分采样 —— BusyBox sleep 不支持小数秒，
#           请求内 sleep 0.5 采样必然失败（日志刷屏 + 1ms 窗口致 4 核量化失真 0/25/50/75/100%）；
#           改为与上次请求存档的 /proc/stat 计数器做差（窗口即轮询间隔约 2s），
#           状态文件 /tmp/statusmon-cpu.state，窗口不足 1s 或回绕时沿用上次结果
# v4.9 变更：每日流量分类改用 nftables 双向计数 —— 实测 conntrack 字节计数在 flow offload 下
#           双向失真（长流计数冻结 / 周期冲刷重复累加），不可用于记账；
#           nft 表 netdev/statusmon_acct：br-lan ingress(-100) 按目的端口计上行、
#           br-lan egress(-100) 按源端口计下行，优先级抢在 flowtable(offload, prio 0) 窃取包之前，
#           offload 流量完整计入；LAN 源/目/组播提前 return 排除内网与 rtp2httpd 本地流量；
#           计数后 return 防止落入 other 重复计数；
#           新增 ?accumulate=1 端点（cron 每分钟调用），主轮询路径每次同步累计，
#           归档 /etc/statusmon/proto-YYYY-MM-DD.json（?proto_day 读取）；
#           自愈：累计时自动确保 nft 规则表与 cron 任务存在（重启后 cron 存续，首轮即重建规则）；
#           分类顺序修正：web(80/443/8443) 先于 video(8000-8999)，修复 8443 被区间吞没；
#           弃用旧 /tmp/statusmon-proto-state.json conntrack 增量方案（保留 ?summary=1 实时分类供客户端弹窗）
# v4.10 变更：温度数据源修正 —— 优先 x86_pkg_temp（内核 x86 包温度，与 LuCI 首页一致）
#           其次 coretemp Package，修正此前误用 thermal_zone0=acpitz 主板传感器导致与首页不符；
#           轮询开销优化（实测 112ms/次 → 目标 ≤60ms）：
#           ① 接口表：此前每接口 10+ 进程 spawn 且每个 ethX 跑两次 uci show network，
#              改为一次性批量读取（/proc/net/dev + sysfs glob + ip -o + uci 预取，循环内零 spawn）；
#           ② /proc/net/snmp 协议统计 12 个 grep/echo 管道合并为单次 awk；
#           ③ 主路径 nft 累计节流：state 距上次不足 10s 跳过（cron 仍每分钟，弹窗强制刷新）
# v4.12 变更：流量统计重构 —— 弃用「WAN 接口按天累计」（访问驱动：页面无人访问时停摆，
#           跨天归档中断产生黑洞日、恢复后停摆期流量混叠计入恢复日；接口计数器无历史不可追溯）；
#           改为「协议分类月度总计」：nft 计数器口径，cron 每分钟驱动持续累计，
#           每月 1 日 0 点跨月清零，上月归档 /etc/statusmon/month-YYYY-MM.json 备查；
#           traffic 字段输出 {month, today, total, cats}（today 供协议弹窗对账）；
#           ?proto_day 按日明细弹窗保留；state.json 移除 wan 字段；
#           修复归档 JSON 解析槽位错位（旧 p[i+4]+0 取到键名字符串恒为 0 的死 bug，
#           正确为键在 p[i] 步进 8、值在 p[i+3]/p[i+5] 且需剥离前导冒号）
# v4.13 修复：流量统计不准 ——
#           ① PPPoE 重拨后 pppoe-wan ifindex 变化，netdev ingress 钩子绑死旧设备，
#              表仍在但下行计数停摆；改为检测 WAN 设备变化并只重建 dl 链（保留计数器）；
#           ② lan6 仅收 proto kernel（fe80），漏掉 GUA/ULA proto static，IPv6 局域网
#              互访被算作上网；改为 kernel+static 全量刷新 set；
#           ③ 客户端流量改 inet/forward 动态 set 计数，弃用 conntrack 字节
#              （连接过期清零导致累计严重偏小）；
#           ④ PPPoE WAN 改回逻辑口自身计数器（物理口含 PPP 开销与非 PPP 帧，偏大）
# v4.14 修复：本月流量总计改 WAN 接口累计（pppoe-wan /proc/net/dev，cron 持续），
#           分类按 nft 占比对齐到 WAN 总量（HTTPS 视频/网盘仍用域名 IP set 识别）；
#           旧口径把分类计数加总当总量，HTTPS 大量进 web，数字与运营商账单对不上
# v4.15 修复：HTTPS 视频被算成网页 —— dnsmasq nftset 遇 CNAME/DoH 漏填 vidips，
#           443 落到 web；改为持久化 IP + 每 5 分钟解析视频/网盘域名灌 set
#           （须在 web 规则之前命中）。历史已计入 web 的字节无法回改，新流量按域名分类
# v4.16 变更：新增 CPU/内存/温度 24 小时滚动曲线 —— cron 每分钟采样，
#           工作副本 /tmp/statusmon-sys-hist.txt，持久化 /etc/statusmon/sys-hist.txt；
#           ?sys_hist=1 返回近 24h 点列；CPU 用独立 1 分钟差分窗口，不干扰 5s 轮询
# v4.17 修复：客户端 IPv6 只取 REACHABLE/DELAY/PROBE，丢掉邻居表 STALE 残留
#           （关 IPv6 / 前缀轮换后旧 SLAAC 会在邻居表里挂很久）
# v4.18 修复：协议统计 TCP 活跃被 [ASSURED] 覆盖成 0；外部连接改动态识别本机
#           LAN/WAN/ULA 前缀（不再写死 240e:039c:2ba9:4f30）；TCP 用 $6 状态位
#           ESTABLISHED/OFFLOAD，UDP 用 [ASSURED]/[OFFLOAD]
# v4.19 修复：外部连接改为「原始 src 或 dst 为公网」—— NAT 后入站 src 几乎都是
#           WAN 本机地址，旧口径会显示 0；同时覆盖 LAN 访问公网的出站连接
# v4.20 修复：HTTPS 直播仍进网页 —— 静态 nslookup 拿不到 CDN 节点；改为
#           dnsmasq nftset 按域名动态灌 vidips，并从 QUIC(udp443)/大流量
#           TCP443 回填 CDN IP（须在 web 规则之前命中）

echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""

STATE=/tmp/statusmon-state.json
NOW=$(date +%s)

# ===== 每日流量分类累计引擎（v4.9，nftables 计数）=====
# 原理：nft 表 netdev/statusmon_acct 在 br-lan ingress/egress 以 -100 优先级分类计数，
#       先于 fw4 flowtable（offload，优先级 0）窃取包，offload 流量完整计入；
#       本函数读计数器与上次快照做差，累计到当日归档 JSON（?proto_day 读取）。
# 自愈：规则表/缺失自动重建（计数器从 0 重计）；cron 任务缺失自动补写。
PROTO_DIR=/etc/statusmon
PROTO_STATE=/tmp/statusmon-proto-state.txt
SM_TABLE=statusmon_acct
SM_CATS="web video game dns ntp download other"
SM_LAN_DEV=br-lan
SM_CLI_TABLE=statusmon_cli
SM_WAN_FILE=/tmp/statusmon-wan.dev
SYS_HIST_TMP=/tmp/statusmon-sys-hist.txt
SYS_HIST_FILE=/etc/statusmon/sys-hist.txt
SYS_HIST_CPU=/tmp/statusmon-sys-hist.cpu
SYS_HIST_FLUSH=/tmp/statusmon-sys-hist.flush
SYS_HIST_WIN=86400

_sm_wan_dev() {
    local d
    d=$(ifstatus wan 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
    [ -n "$d" ] && [ -d "/sys/class/net/$d" ] && { echo "$d"; return 0; }
    [ -d /sys/class/net/pppoe-wan ] && { echo pppoe-wan; return 0; }
    echo "pppoe-wan"
}

_sm_lan6_elems() {
    local e
    e=$(ip -6 route show dev "$SM_LAN_DEV" 2>/dev/null | awk '
      $1 ~ /^f[eE]80:/ { next }
      $1 ~ /^ff/ { next }
      /proto (kernel|static)/ { printf "%s, ", $1 }
    ')
    echo "${e}fe80::/10, ff00::/8"
}

_sm_nft_add_dl_rules() {
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport { 8567, 8568, 8569, 6881-6889, 9921, 9922, 25565, 27015, 3478, 43793 }' counter name "game_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 53' counter name "dns_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 123' counter name "ntp_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 51413' counter name "download_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip saddr @vidips4 counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip6 saddr @vidips6 counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip saddr @dlips4 counter name "download_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip6 saddr @dlips6 counter name "download_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto tcp th sport { 80, 443, 8443 }' counter name "web_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto tcp th sport { 1935, 8000-8999 }' counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto udp th sport { 443, 1935, 8000-8999 }' counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl counter name "other_dl" return >/dev/null 2>&1
}

_sm_nft_cli_ensure() {
    nft list table inet $SM_CLI_TABLE >/dev/null 2>&1 && return 0
    nft add table inet $SM_CLI_TABLE >/dev/null 2>&1 || return 1
    nft add set inet $SM_CLI_TABLE ul4 '{ type ipv4_addr; flags dynamic,timeout; timeout 1d; counter; }' >/dev/null 2>&1
    nft add set inet $SM_CLI_TABLE dl4 '{ type ipv4_addr; flags dynamic,timeout; timeout 1d; counter; }' >/dev/null 2>&1
    nft add set inet $SM_CLI_TABLE ul6 '{ type ipv6_addr; flags dynamic,timeout; timeout 1d; counter; }' >/dev/null 2>&1
    nft add set inet $SM_CLI_TABLE dl6 '{ type ipv6_addr; flags dynamic,timeout; timeout 1d; counter; }' >/dev/null 2>&1
    nft add chain inet $SM_CLI_TABLE smfwd '{ type filter hook forward priority -150; policy accept; }' >/dev/null 2>&1
    nft add rule inet $SM_CLI_TABLE smfwd iifname "$SM_LAN_DEV" oifname != "$SM_LAN_DEV" oifname != "docker0" ip saddr 192.168.10.0/24 add @ul4 '{ ip saddr }' >/dev/null 2>&1
    nft add rule inet $SM_CLI_TABLE smfwd iifname != "$SM_LAN_DEV" iifname != "docker0" oifname "$SM_LAN_DEV" ip daddr 192.168.10.0/24 add @dl4 '{ ip daddr }' >/dev/null 2>&1
    nft add rule inet $SM_CLI_TABLE smfwd iifname "$SM_LAN_DEV" oifname != "$SM_LAN_DEV" oifname != "docker0" ip6 saddr != fe80::/10 add @ul6 '{ ip6 saddr }' >/dev/null 2>&1
    nft add rule inet $SM_CLI_TABLE smfwd iifname != "$SM_LAN_DEV" iifname != "docker0" oifname "$SM_LAN_DEV" ip6 daddr != fe80::/10 add @dl6 '{ ip6 daddr }' >/dev/null 2>&1
}

_sm_nft_refresh_lan6() {
    local V6EL OLDV6
    V6EL=$(_sm_lan6_elems)
    OLDV6=$(cat /tmp/statusmon-lan6.elems 2>/dev/null)
    [ "$V6EL" = "$OLDV6" ] && return 0
    nft flush set netdev $SM_TABLE lan6 >/dev/null 2>&1
    nft add element netdev $SM_TABLE lan6 '{ '"$(echo "$V6EL" | sed 's/, *$//')"' }' >/dev/null 2>&1
    echo "$V6EL" > /tmp/statusmon-lan6.elems 2>/dev/null
}

_sm_nft_ensure() {
    local SM_WAN_DEV CUR_WAN NEED_FULL=0 CUR_IFIDX OLD_BIND OLD_IFIDX NEED_REBIND
    SM_WAN_DEV=$(_sm_wan_dev)
    _sm_nft_cli_ensure
    if nft list table netdev $SM_TABLE >/dev/null 2>&1; then
        if ! nft list chain netdev $SM_TABLE dl >/dev/null 2>&1; then
            nft delete table netdev $SM_TABLE >/dev/null 2>&1
            NEED_FULL=1
        fi
    else
        NEED_FULL=1
    fi
    if [ "$NEED_FULL" = "0" ]; then
        CUR_WAN=$(nft list chain netdev $SM_TABLE dl 2>/dev/null | awk '/hook ingress device/{
            for(i=1;i<=NF;i++) if($i=="device"){ gsub(/"/,"",$(i+1)); print $(i+1); exit }
        }')
        CUR_IFIDX=$(cat /sys/class/net/"$SM_WAN_DEV"/ifindex 2>/dev/null)
        OLD_BIND=$(cat "$SM_WAN_FILE" 2>/dev/null)
        OLD_IFIDX=${OLD_BIND##* }
        NEED_REBIND=0
        [ -n "$CUR_WAN" ] && [ "$CUR_WAN" != "$SM_WAN_DEV" ] && NEED_REBIND=1
        [ -n "$OLD_IFIDX" ] && [ -n "$CUR_IFIDX" ] && [ "$CUR_IFIDX" != "$OLD_IFIDX" ] && NEED_REBIND=1
        if [ "$NEED_REBIND" = "1" ]; then
            nft delete chain netdev $SM_TABLE dl >/dev/null 2>&1
            nft add chain netdev $SM_TABLE dl '{ type filter hook ingress device "'"$SM_WAN_DEV"'" priority -100; policy accept; }' >/dev/null 2>&1
            _sm_nft_add_dl_rules
        fi
        _sm_nft_refresh_lan6
        echo "$SM_WAN_DEV $CUR_IFIDX" > "$SM_WAN_FILE" 2>/dev/null
        return 0
    fi
    nft add table netdev $SM_TABLE >/dev/null 2>&1 || return 1
    local c d LAN4 V6EL
    for c in $SM_CATS; do for d in ul dl; do nft add counter netdev $SM_TABLE ${c}_${d} >/dev/null 2>&1; done; done
    LAN4=$(ip -4 route show dev $SM_LAN_DEV 2>/dev/null | awk '/proto kernel/{print $1; exit}')
    [ -n "$LAN4" ] || LAN4="192.168.10.0/24"
    nft add set netdev $SM_TABLE lanv4 '{ type ipv4_addr; flags interval; elements = { '"$LAN4"', 224.0.0.0/4, 255.255.255.255 }; }' >/dev/null 2>&1
    V6EL=$(_sm_lan6_elems)
    nft add set netdev $SM_TABLE lan6 '{ type ipv6_addr; flags interval; elements = { '"$(echo "$V6EL" | sed 's/, *$//')"' }; }' >/dev/null 2>&1
    nft add set netdev $SM_TABLE vidips4 '{ type ipv4_addr; }' >/dev/null 2>&1
    nft add set netdev $SM_TABLE vidips6 '{ type ipv6_addr; }' >/dev/null 2>&1
    nft add set netdev $SM_TABLE dlips4 '{ type ipv4_addr; }' >/dev/null 2>&1
    nft add set netdev $SM_TABLE dlips6 '{ type ipv6_addr; }' >/dev/null 2>&1
    nft add chain netdev $SM_TABLE ul '{ type filter hook ingress device "'"$SM_LAN_DEV"'" priority -100; policy accept; }' >/dev/null 2>&1
    nft add chain netdev $SM_TABLE dl '{ type filter hook ingress device "'"$SM_WAN_DEV"'" priority -100; policy accept; }' >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul ip daddr @lanv4 return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul ip6 daddr @lan6 return >/dev/null 2>&1
    # v4.10: WAN ingress 无需排除 LAN 源地址 >/dev/null 2>&1
    # v4.10: WAN ingress 无需排除 LAN IPv6 源地址 >/dev/null 2>&1
    # 分类顺序：game → dns → ntp → download(51413) → 域名IP(vidips/dlips) → web(80/443/8443 tcp)
    #           → video(1935,8000-8999 + QUIC udp443) → other
    # 上行按目的端口，下行按源端口；计数后 return 防止落入 other 重复计数
    nft add rule netdev $SM_TABLE ul 'meta l4proto { tcp, udp } th dport { 8567, 8568, 8569, 6881-6889, 9921, 9922, 25565, 27015, 3478, 43793 }' counter name "game_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport { 8567, 8568, 8569, 6881-6889, 9921, 9922, 25565, 27015, 3478, 43793 }' counter name "game_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'meta l4proto { tcp, udp } th dport 53' counter name "dns_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 53' counter name "dns_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'meta l4proto { tcp, udp } th dport 123' counter name "ntp_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 123' counter name "ntp_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'meta l4proto { tcp, udp } th dport 51413' counter name "download_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto { tcp, udp } th sport 51413' counter name "download_dl" return >/dev/null 2>&1
    # v4.12 域名优先分类（须在 web 之前命中）
    nft add rule netdev $SM_TABLE ul ip daddr @vidips4 counter name "video_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul ip6 daddr @vidips6 counter name "video_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul ip daddr @dlips4 counter name "download_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul ip6 daddr @dlips6 counter name "download_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip saddr @vidips4 counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip6 saddr @vidips6 counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip saddr @dlips4 counter name "download_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl ip6 saddr @dlips6 counter name "download_dl" return >/dev/null 2>&1
    # v4.12：web 仅 TCP；QUIC(udp 443) 为视频 App 实际载体，归 video
    nft add rule netdev $SM_TABLE ul 'meta l4proto tcp th dport { 80, 443, 8443 }' counter name "web_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto tcp th sport { 80, 443, 8443 }' counter name "web_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'meta l4proto tcp th dport { 1935, 8000-8999 }' counter name "video_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto tcp th sport { 1935, 8000-8999 }' counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'meta l4proto udp th dport { 443, 1935, 8000-8999 }' counter name "video_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl 'meta l4proto udp th sport { 443, 1935, 8000-8999 }' counter name "video_dl" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE ul 'ether type { ip, ip6 }' counter name "other_ul" return >/dev/null 2>&1
    nft add rule netdev $SM_TABLE dl counter name "other_dl" return >/dev/null 2>&1
    echo "$SM_WAN_DEV $(cat /sys/class/net/"$SM_WAN_DEV"/ifindex 2>/dev/null)" > "$SM_WAN_FILE" 2>/dev/null
    _sm_sets_restore
    return 0
}

_sm_sets_dump() {
    nft list set netdev $SM_TABLE "$1" 2>/dev/null | tr ',{}' '\n' | awk '{
      gsub(/^[ \t]+|[ \t]+$/, "")
      if($0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $0
      else if($0 ~ /^[0-9a-fA-F:]+$/ && index($0,":")) print $0
    }'
}

_sm_sets_restore() {
    local f el
    mkdir -p "$PROTO_DIR" 2>/dev/null
    for f in vidips4 vidips6 dlips4 dlips6; do
        [ -s "$PROTO_DIR/$f.txt" ] || continue
        el=$(awk 'NF && !seen[$0]++{printf "%s, ", $0}' "$PROTO_DIR/$f.txt")
        [ -n "$el" ] && nft add element netdev $SM_TABLE $f '{ '"$(echo "$el" | sed 's/, *$//')"' }' >/dev/null 2>&1
    done
}

_sm_sets_save() {
    local f
    mkdir -p "$PROTO_DIR" 2>/dev/null
    for f in vidips4 vidips6 dlips4 dlips6; do
        _sm_sets_dump "$f" | awk 'NF && !seen[$0]++' > "$PROTO_DIR/$f.txt"
