_sm_resolve_hosts() {
    local h
    for h in $1; do
        nslookup "$h" 127.0.0.1 2>/dev/null
    done | awk '
      /^Address:/{
        a=$2
        if(a=="") next
        if(a ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/){
          if(a ~ /^10\./ || a ~ /^192\.168\./ || a ~ /^127\./ || a ~ /^169\.254\./) next
          if(a ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) next
          print a; next
        }
        if(a ~ /:/ && a !~ /\./){
          if(a ~ /^[fF][eE]80:/ || a ~ /^[fF][cCdD]/ || a ~ /^::1$/) next
          print a
        }
      }'
}

_sm_sets_add_ips() {
