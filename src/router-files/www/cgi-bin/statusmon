    [ -n "$v4" ] && nft add element netdev $SM_TABLE ${set}4 '{ '"$(echo "$v4" | sed 's/, *$//')"' }' >/dev/null 2>&1
    [ -n "$v6" ] && nft add element netdev $SM_TABLE ${set}6 '{ '"$(echo "$v6" | sed 's/, *$//')"' }' >/dev/null 2>&1
}

