_sm_sets_harvest() {
    [ -f /proc/net/nf_conntrack ] || return 0
    awk '
      BEGIN{
        skip["223.5.5.5"]=1; skip["223.6.6.6"]=1; skip["8.8.8.8"]=1; skip["8.8.4.4"]=1
        skip["1.1.1.1"]=1; skip["1.0.0.1"]=1; skip["114.114.114.114"]=1
        skip["119.29.29.29"]=1; skip["180.76.76.76"]=1; skip["9.9.9.9"]=1
      }
      {
        p=$3; d1=""; dport=""; b1=0; b2=0; pk=0
        for(i=1;i<=NF;i++){
          if($i~/^dst=/&&d1=="") d1=substr($i,5)
          if($i~/^dport=/&&dport=="") dport=substr($i,7)
          if($i~/^bytes=/){ if(!b1) b1=substr($i,7)+0; else b2=substr($i,7)+0 }
          if($i~/^packets=/) pk+=substr($i,9)+0
        }
        if(d1==""||dport!="443") next
        if(skip[d1]) next
        if(d1 ~ /^10\./ || d1 ~ /^192\.168\./ || d1 ~ /^127\./ || d1 ~ /^169\.254\./) next
        if(d1 ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) next
        if(d1 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./) next
        if(d1 ~ /^[fF][eE]80:/ || d1 ~ /^[fF][cCdD]/ || d1=="::1") next
        bytes=b1+b2
        if(p=="udp") print d1
        else if(p=="tcp" && (bytes>=262144 || pk>=200)) print d1
      }
    ' /proc/net/nf_conntrack | _sm_sets_add_ips vidips
}

